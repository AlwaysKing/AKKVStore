# 复制为 .env 后修改。.env 已被 .gitignore 忽略，不要提交到仓库。

# 会话 cookie 的 HMAC 签名密钥，至少 16 字符。
# 建议生成：openssl rand -base64 32
AKKV_SESSION_SECRET=change-this-to-a-random-32-byte-secret

# 管理后台会话有效期，Go duration 格式。
AKKV_SESSION_TTL=12h

# 通过 HTTPS 访问时必须为 true；只在本机 HTTP 调试时才设为 false。
AKKV_COOKIE_SECURE=true

# 浏览器跨域调用公开 API 时允许的 Origin，逗号分隔；* 表示允许所有。
# 不涉及浏览器调用时可以保持 *，也可以收紧为具体域名；显式留空表示关闭 CORS。
AKKV_CORS_ORIGINS=*

# 可选：系统数据库路径。默认 <AKKV_DATA_DIR>/system.db。
# project 数据库固定存放在 <AKKV_DATA_DIR>/projects/<projectID>/project.db。
# AKKV_SYSTEM_DB_PATH=/data/system.db

# 单个 value 的大小上限（字节）。0 表示不限制。
AKKV_MAX_VALUE_BYTES=104857600

# 不超过该大小的 value 内联存 SQLite BLOB，超过则流式写入外部文件。
AKKV_INLINE_THRESHOLD=262144

# 容器时区，影响管理页显示的时间。
TZ=Asia/Shanghai
